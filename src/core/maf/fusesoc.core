CAPI=2:
name: uat:core:maf:1.0.0
description: moving average filter

filesets:
  rtl:
    files: [
      rtl/maf.sv
    ] 

  tb:
    files: [
      tb/maf_tb.sv
    ]
    
targets:
  default: &default
    filesets: [rtl]
    filters: [autotype]

#############################################
#                SIMULATION                 #
#############################################
    
  sim: &sim
    <<: *default
    filesets_append: [tb]
    toplevel: maf_tb
    parameters: [
        p_filter_len=16
    ]

  sim_icarus: &sim_icarus
    <<: *sim
    description: Simulate the design using IVerilog simulator
    default_tool: icarus
    tools:
      icarus:
        iverilog_options: [-g2012]
      
  sim_icarus_wave:
    <<: *sim_icarus
    description: Simulate the design using IVerilog simulator and then launch GTKWave
    hooks:
      post_run: [gtkwave]
      
#############################################
#                SYNTHESIS                  #
#############################################

#############################################
#                PARAMETERS                 #
#############################################

parameters:
  p_filter_len:
    datatype    : int
    description : clock input frequency 
    paramtype   : vlogparam

#############################################
#                 SCRIPTS                   #
#############################################

scripts:
  gtkwave:
    cmd: [gtkwave, wave.vcd]